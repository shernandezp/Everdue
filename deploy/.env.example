# Copy to deploy/.env and edit. Only the two Bootstrap values are required.

EVERDUE_ADMIN_EMAIL=admin@example.com
EVERDUE_ADMIN_PASSWORD=ChangeThisOnFirstLogin1!

EVERDUE_TENANT_NAME=Everdue
# IANA identifier — every period and due date is computed in this zone.
EVERDUE_TIMEZONE=America/Bogota
EVERDUE_DIGEST_HOUR=7
EVERDUE_LANGUAGE=es

# Optional: without SMTP the daily digest is skipped with a logged warning.
EVERDUE_SMTP_HOST=
EVERDUE_SMTP_PORT=587
EVERDUE_SMTP_USER=
EVERDUE_SMTP_PASSWORD=
EVERDUE_SMTP_FROM=
