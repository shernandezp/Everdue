<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="Common.Mediator" Version="0.0.1" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!--
      CSV *reading* only (MIT). Quoting, embedded newlines, ragged rows and BOM handling are where hand-rolled
      CSV readers go wrong, so that part is a library's job. Writing stays ours: its only edge cases are
      quoting and the OWASP formula-injection prefix, and the prefix is a rule we own.
    -->
    <PackageVersion Include="Sylvan.Data.Csv" Version="1.4.4" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core / EF Core">
    <!--
      The in-box Google handler, not Google.Apis.Auth.AspNetCore3 (which the .NET 10 docs now
      demonstrate): this is one OAuth handler, and pulling Google's client-library graph into a
      single-file publish buys nothing. Swapping is one call site if it is ever deprecated.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Generates docs/openapi/v1.json at build time so the contract can be committed and diffed. -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.16" />
  </ItemGroup>

  <!--
    Transitive pins. Central transitive pinning is on, so these override what EF Core and
    Microsoft.AspNetCore.OpenApi drag in by default.
      Microsoft.OpenApi 2.0.0            -> GHSA-v5pm-xwqc-g5wc (stack overflow on circular $ref), fixed in 2.7.5.
      SQLitePCLRaw.lib.e_sqlite3 2.1.11  -> CVE-2025-6965 (SQLite < 3.50.2 memory corruption); only the 3.x line ships a fixed SQLite.
  -->
  <ItemGroup Label="Transitive pins (security)">
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
