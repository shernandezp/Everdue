{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Everdue": "Debug"
    }
  },

  // Keeps the development database OUT of the build output. Paths resolve against the binary, so
  // this lands in src/Server/data — three levels up from bin/<config>/<tfm>. Without it the file
  // sits inside bin/, and `dotnet clean`, an IDE Rebuild, or switching Debug/Release silently takes
  // your accumulated test data with it. Production is unaffected: it still defaults to ./data next
  // to the binary, which for a published install is exactly right.
  // Delete src/Server/data to start over deliberately.
  "DataDir": "../../../data",

  "Tenant": {
    "Name": "Everdue (dev)",
    "TimeZoneId": "America/Bogota",
    "DigestHourLocal": 7,
    "DefaultLanguage": "es"
  },

  "Bootstrap": {
    "AdminEmail": "admin@everdue.local",
    "AdminPassword": "ChangeMe2026!",
    "AdminDisplayName": "Administrator"
  }
}
