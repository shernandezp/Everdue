{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DataDir": "./data",

  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "ConnectionStrings": {
    "Default": ""
  },

  "Tenant": {
    "Name": "Everdue",
    "TimeZoneId": "UTC",
    "DigestHourLocal": 7,
    "DefaultLanguage": "es"
  },

  "Engine": {
    "Enabled": true,
    "TickMinutes": 5,
    "MaxOccurrencesPerResponsibilityPerTick": 5000
  },

  "Digest": {
    "Enabled": true,
    "CheckMinutes": 10
  },

  "Notifications": {
    "Enabled": true,
    "DispatchSeconds": 30,
    "MaxAttempts": 5,
    "RetentionDays": 90,
    "BatchSize": 100,
    "MissedNotificationWindowHours": 24
  },

  "Reminders": {
    "Enabled": true,
    "CheckMinutes": 10
  },

  "Telegram": {
    "PollingEnabled": true,
    "PollTimeoutSeconds": 30
  },

  "Attachments": {
    "MaxSizeBytes": 10485760,
    "MaxPerWorkItem": 10,
    "AllowedContentTypes": [ "image/png", "image/jpeg", "image/webp", "image/heic", "application/pdf", "text/plain" ],
    "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".webp", ".heic", ".pdf", ".txt" ]
  },

  "Checklists": {
    "MaxItemsPerTemplate": 50,
    "MaxItemsPerWorkItem": 50
  },

  "EntityFields": {
    "MaxPerEntityType": 10
  },

  "Exports": {
    "MaxRows": 50000
  },

  "Import": {
    "MaxRows": 5000,
    "MaxSizeBytes": 2097152,
    "PreviewRows": 20,
    "MaxReportedFailures": 1000
  },

  "Webhooks": {
    "Enabled": true,
    "DispatchSeconds": 15,
    "MaxAttempts": 5,
    "BatchSize": 100,
    "MaxConsecutiveFailures": 10,
    "MaxSubscriptions": 10,
    "RetentionDays": 30,
    "AllowInsecureUrls": false,
    "TimeoutSeconds": 10
  },

  "Demo": {
    "Seed": false,
    "Password": "EverdueDemo2026!",
    "Months": 6,
    "AllowReset": false
  },

  "Insights": {
    "ChronicMissCount": 3,
    "ChronicWindowPeriods": 8,
    "MinOccurrencesForRate": 5,
    "DefaultTrendBuckets": 12,
    "MaxTrendBuckets": 52,
    "TopEntities": 15
  },

  "App": {
    "PublicBaseUrl": ""
  },

  "Auth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },

  "Security": {
    "RequireHttps": false,
    "LoginAttemptsPerMinute": 30,
    "ApiRequestsPerMinute": 600
  },

  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminDisplayName": "Administrator"
  },

  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "",
    "FromName": "Everdue",
    "UseStartTls": true
  }
}
